# Переменные conf-kit для docker compose. Скопируйте в deploy/.env и заполните; .env в git не попадает.
# Пустое значение — настройка не меняется (её можно задать в дашборде PocketBase /_/).

# Домен сайта (DNS A-запись → IP сервера); Caddy выпустит сертификат Let's Encrypt
CONF_DOMAIN=conf.konkin-nikita.ru
# Адрес для ссылок в ответах API и письмах (invite_url, preview_url, сброс пароля)
CONF_PUBLIC_URL=https://conf.konkin-nikita.ru
CONF_APP_NAME=conf-kit

# Почта: сброс пароля, подтверждение адреса. 465 — TLS, 587 — STARTTLS
CONF_MAIL_FROM=
CONF_MAIL_NAME=Конференции
CONF_SMTP_HOST=
CONF_SMTP_PORT=465
CONF_SMTP_USER=
CONF_SMTP_PASSWORD=

# Резервные копии PocketBase (pb_data целиком): расписание cron и сколько хранить
CONF_BACKUP_CRON=0 3 * * *
CONF_BACKUP_KEEP=7
# Копии в S3-совместимое хранилище (Yandex Object Storage, Selectel, …); без бакета — только на диске сервера
CONF_S3_BUCKET=
CONF_S3_ENDPOINT=https://storage.yandexcloud.net
CONF_S3_REGION=ru-central1
CONF_S3_KEY=
CONF_S3_SECRET=
CONF_S3_PATH_STYLE=

# Встроенные лимиты запросов PocketBase (вход, регистрация, API)
CONF_RATE_LIMITS=1
